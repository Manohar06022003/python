

class Demo:
    list=[]
    def __init__(self, a):
        self.list=a

    def display(self):
        print(self.list,"old list")
        for i in range (len(self.list)):
            if self.list[i]==0:
                for j in range(i+1,len(self.list)):
                    if self.list[j]!=0:
                        self.list[i],self.list[j]=self.list[j],self.list[i]
                        break
        return self.list,"new list"            
class process:
    def send(self):
        a=[0,1,2,0,0,3,0,4,0,0,0,0,5,0,0,0,0]
        obj= Demo(a)
        print(obj.display())

